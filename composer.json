{
    "name": "php-collective/toml",
    "description": "A TOML parser and encoder for PHP with AST access and collected parse errors",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "toml",
        "parser",
        "encoder",
        "configuration",
        "config",
        "developer-tools"
    ],
    "authors": [
        {
            "name": "Mark Scherer"
        }
    ],
    "homepage": "https://php-collective.github.io/toml/",
    "require": {
        "php": ">=8.1",
        "symfony/polyfill-mbstring": "^1.30"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.5 || ^12.5 || ^13.0",
        "phpstan/phpstan": "^2.0",
        "php-collective/code-sniffer": "dev-master"
    },
    "suggest": {
        "ext-ds": "For improved performance with Set-based key tracking"
    },
    "autoload": {
        "psr-4": {
            "PhpCollective\\Toml\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PhpCollective\\Toml\\Test\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyze",
        "cs-check": "phpcs --colors --parallel=16",
        "cs-fix": "phpcbf --colors --parallel=16",
        "bench:compare": "php benchmarks/compare-libraries.php"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "minimum-stability": "stable",
    "bin": [
        "bin/toml-validate"
    ]
}
